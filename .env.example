# Neon Postgres
DATABASE_URL=""

# NextAuth
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Set to "true" to allow new account sign-ups via POST /api/auth/register and
# the /register page. Defaults to closed (disabled) — this is a solo demo
# instance, GitHub OAuth is separately restricted in src/auth.ts's signIn
# callback to only sign in already-existing users regardless of this flag.
REGISTRATION_ENABLED="false"

# Resend (email verification)
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=""
# Set to "false" to skip sending verification emails and auto-verify new
# users instead — useful until a Resend sending domain is verified. Defaults
# to enabled (any value other than the literal string "false").
EMAIL_VERIFICATION_ENABLED="true"

# Upstash Redis (rate limiting on auth endpoints)
# Rate limiting fails open (requests are allowed) if these are unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""
# Set to "true" to actually enforce free-tier item/collection caps and block
# file/image uploads for non-Pro users. Defaults to disabled (unlocked for all
# users) per project-overview.md's dev-mode note.
ENFORCE_PLAN_LIMITS="false"

# Separate test-mode Stripe client used only for the public guest demo
# account's Checkout flow (src/lib/stripe.ts) — lets a visitor see a real,
# working Checkout page with test cards, with zero chance of a real charge.
# Set STRIPE_WEBHOOK_SECRET_TEST from a second, TEST-mode webhook endpoint in
# the Stripe Dashboard (same URL as the live-mode one) for the demo account to
# actually flip to "Pro" after a completed test payment.
STRIPE_SECRET_KEY_TEST=""
STRIPE_PRICE_ID_MONTHLY_TEST=""
STRIPE_PRICE_ID_YEARLY_TEST=""
STRIPE_WEBHOOK_SECRET_TEST=""

# Mistral API key
MISTRAL_API_KEY=""

# Public guest demo account (feature/demo-account-login) — recruiters/prospects
# auto-sign into this free-tier account from the homepage's "Try the Live Demo"
# button (src/actions/demo.ts). Seeded/created by `npm run db:seed` when set;
# the "Try the Live Demo" button is hidden if either var is unset.
DEMO_ACCOUNT_EMAIL=""
DEMO_ACCOUNT_PASSWORD=""

# Shared secret verified by GET /api/cron/reset-demo, which Vercel Cron
# (vercel.json) hits daily to reset the demo account's data back to baseline.
CRON_SECRET=""