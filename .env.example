# Neon Postgres
DATABASE_URL=""

# NextAuth
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Set to "true" to allow new account sign-ups via POST /api/auth/register and
# the /register page. Defaults to closed (disabled) — this is a solo demo
# instance, GitHub OAuth is separately restricted in src/auth.ts's signIn
# callback to only sign in already-existing users regardless of this flag.
REGISTRATION_ENABLED="false"

# Resend (email verification)
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=""
# Set to "false" to skip sending verification emails and auto-verify new
# users instead — useful until a Resend sending domain is verified. Defaults
# to enabled (any value other than the literal string "false").
EMAIL_VERIFICATION_ENABLED="true"

# Upstash Redis (rate limiting on auth endpoints)
# Rate limiting fails open (requests are allowed) if these are unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""
# Set to "true" to actually enforce free-tier item/collection caps and block
# file/image uploads for non-Pro users. Defaults to disabled (unlocked for all
# users) per project-overview.md's dev-mode note.
ENFORCE_PLAN_LIMITS="false"

# Mistral API key
MISTRAL_API_KEY=""